# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables — NEVER commit these
.env
backend/.env
frontend/.env
.env.local
.env.production

# Build output
frontend/dist/
frontend/build/

# Uploaded files — multer writes here temporarily before Cloudinary upload;
# these shouldn't be committed, and normally get cleaned up automatically anyway
backend/public/*
!backend/public/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Package manager artifacts (keep package-lock.json — don't ignore that one)
.npm/